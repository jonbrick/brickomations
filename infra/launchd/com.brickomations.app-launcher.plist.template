<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brickomations.app-launcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/projects/brickomations/scripts/ensure-apps-running.sh</string>
    </array>

    <!-- Fires before each Cowork event so Claude Desktop is up. `open -a` is -->
    <!-- idempotent so we can safely fire both apps each time.                -->
    <!--  5:55 AM — before 6 AM Cowork morning-brief                          -->
    <!--  8:40 PM — before the 9:20 PM Cowork evening-processor. Granola Sync -->
    <!--  runs its first cycle 30 min after Obsidian loads, so a relaunch     -->
    <!--  here syncs by ~9:10 PM, ahead of the 9:15 render and 9:20 processor -->
    <!--  (was 8:55 PM — a relaunch then synced at 9:25, after the processor; -->
    <!--  Mon 2026-10-26 and Thu 2026-10-29).                                 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>5</integer>
            <key>Minute</key>
            <integer>55</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>20</integer>
            <key>Minute</key>
            <integer>40</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>__HOME__/projects/brickomations/local/logs/app-launcher-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/projects/brickomations/local/logs/app-launcher-stderr.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__/projects/brickomations</string>
</dict>
</plist>
