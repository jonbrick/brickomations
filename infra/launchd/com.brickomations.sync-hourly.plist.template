<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brickomations.sync-hourly</string>

    <!-- Light tier: tokens → collect → calendar update (unchanged records    -->
    <!-- skipped) → Linear tasks-only → pull → granola-logs. Wrapped in       -->
    <!-- caffeinate so the system holds awake for exactly the run's lifetime. -->
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/projects/brickomations/scripts/run-with-wakelock.sh</string>
        <string>/opt/homebrew/bin/node</string>
        <string>__HOME__/projects/brickomations/cli/sync.js</string>
        <string>--auto</string>
        <string>--tier=hourly</string>
    </array>

    <!-- Every 2 hours, 7 AM–11 PM, except 9 PM — the evening tier owns that  -->
    <!-- slot (com.brickomations.sync-evening). 5:20 AM is the morning tier.  -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>__HOME__/projects/brickomations/local/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/projects/brickomations/local/logs/launchd-stderr.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__/projects/brickomations</string>
</dict>
</plist>
