<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brickomations.daily-text-morning</string>

    <!-- Texts a plain-text digest of today's daily note (morning sections) with  -->
    <!-- a tappable obsidian:// link back into the note. Fires 20 min after the    -->
    <!-- 6 AM Cowork morning-brief, so the note is already written.                -->
    <!-- No wakelock wrapper: 06:20 sits inside the daily caffeinate window        -->
    <!-- (05:45-23:30) and the script exits in seconds (osascript is timeout-      -->
    <!-- bounded in the script). No heartbeat/watchdog: the delivered text is its  -->
    <!-- own success signal — a missing text is self-evident.                      -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>__HOME__/projects/brickomations/scripts/send-daily-text.js</string>
        <string>--slot</string>
        <string>morning</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>20</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/projects/brickomations/local/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/projects/brickomations/local/logs/launchd-stderr.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__/projects/brickomations</string>
</dict>
</plist>
