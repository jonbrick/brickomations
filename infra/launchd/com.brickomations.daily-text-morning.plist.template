<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brickomations.daily-text-morning</string>

    <!-- Texts today's ### MORNING SUMMARY (the exec-assistant paragraphs the 6 AM  -->
    <!-- Cowork morning-brief writes) with a tappable obsidian:// link back into   -->
    <!-- the note. Fires 06:20; the script polls the note until the summary lands  -->
    <!-- or 06:35, then falls back to ### AT A GLANCE. Bounded: worst case ~15     -->
    <!-- min, inside the daily caffeinate window (05:45-23:30); osascript is       -->
    <!-- timeout-bounded. No heartbeat/watchdog: the delivered text is its own     -->
    <!-- success signal — a missing text is self-evident.                          -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>__HOME__/projects/brickomations/scripts/send-daily-text.js</string>
        <string>--slot</string>
        <string>morning</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>6</integer>
        <key>Minute</key><integer>20</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/projects/brickomations/local/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/projects/brickomations/local/logs/launchd-stderr.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__/projects/brickomations</string>
</dict>
</plist>
