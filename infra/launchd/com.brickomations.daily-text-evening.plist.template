<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brickomations.daily-text-evening</string>

    <!-- Texts today's ### Evening Summary (the exec-assistant paragraphs the 9:20   -->
    <!-- PM Cowork evening-processor writes) with a tappable obsidian:// link.      -->
    <!-- Fires 21:45; the script polls the note until the summary lands or 22:00,   -->
    <!-- then falls back to ### Tasks. Bounded: worst case ~15 min, inside the      -->
    <!-- daily caffeinate window (05:45-23:30); osascript is timeout-bounded.       -->
    <!-- No heartbeat/watchdog: the delivered text is its own success signal.       -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>__HOME__/projects/brickomations/scripts/send-daily-text.js</string>
        <string>--slot</string>
        <string>evening</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>21</integer>
        <key>Minute</key><integer>45</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/projects/brickomations/local/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/projects/brickomations/local/logs/launchd-stderr.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__/projects/brickomations</string>
</dict>
</plist>
